# Copia este fichero a .env para desarrollo local
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esto
DJANGO_DEBUG=true

# Vacío = SQLite local. Para Postgres local:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/andronautic_internal

# Google Workspace (OAuth client tipo "Aplicación web" en Google Cloud Console)
GOOGLE_WORKSPACE_DOMAINS=andronautic.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# API WS de popeye (usa un token de pruebas en desarrollo)
POPEYE_API_BASE_URL=
POPEYE_API_TOKEN=
POPEYE_API_AUTH_HEADER=Authorization
POPEYE_API_AUTH_SCHEME=Bearer

# Gmail: buzón donde llegan las facturas de proveedores (cuenta de servicio con
# delegación de dominio y scope gmail.readonly). Admite el JSON de la clave o su ruta.
GMAIL_MAILBOX=admin@andronautic.com
GMAIL_SERVICE_ACCOUNT_JSON=
GMAIL_INVOICES_LABEL=Gastos
GMAIL_SYNC_DAYS=30

# Cloudflare R2 (opcional en local: sin R2_BUCKET se guarda en ./media)
R2_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

SENTRY_DSN=
